<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Distortion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#08090D</item>
        <item name="android:navigationBarColor">#08090D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Distortion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#08090D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mirror</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Distortion</item>
    </style>
</resources>
